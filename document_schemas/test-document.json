{
    "metadata": {
        "schema_name": "test-document",
        "format_version": "0.0.0"
    },

    "structure": [
        { "fieldname": "id" },
        { "fieldname": "title" },
        { "fieldname": "description", "required": false },
        {
            "fieldname": "includes",
            "fieldtype": "list",
            "fields": [
                { "fieldname": "group" },
                {
                    "fieldname": "tests",
                    "fieldtype": "list",
                    "fields": [
                        { 
                            "fieldname": "filepath",
                            "fieldtype": "ref",
                            "must_exist": true,
                            "extensions": [".yml", ".yaml"],
                            "ref_kind": "procdocs_document",
                            "document_type": "test",
                            "embed_as": "test"
                        }
                    ]
                }
            ]
        }
    ]
}
